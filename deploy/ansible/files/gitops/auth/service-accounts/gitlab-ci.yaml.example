apiVersion: project-hort.de/v1
kind: ServiceAccount
metadata:
  name: gitlab-ci
# CI pull identity for GitLab CI builds: same scope as gha-ci.
#
# The envelope is identity + federation binding only. The read
# authority is the per-repo serviceAccount-subject PermissionGrants in
# `auth/grants/gitlab-ci-read-*.yaml`.
spec:
  federatedIdentities:
    - issuer: gitlab                  # references OidcIssuer metadata.name
      claims:
        # CONFIRM: verify the exact claim name from a real id_token on
        # gitlab.kdp.kloni.cloud before go-live. GitLab OIDC id_tokens
        # typically emit `project_path` as `<namespace>/<project>`.
        project_path: "REPLACE_ME/hort"  # CONFIRM: set to actual GitLab group/namespace
