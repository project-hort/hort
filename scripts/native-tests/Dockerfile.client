# syntax=docker/dockerfile:1.26
# scripts/native-tests/Dockerfile.client
# One image with every client tool the scenarios need, so each scenario runs in
# a container instead of on a host with drifting toolchains (no PEP 668 venv
# dance, no host node/cargo version skew). Built (cached) by run.sh, which passes
# the REPO ROOT as the build context (stage 1 needs the workspace).

# ---------- Stage 1: build hort-cli (the admin CLI) ----------
# The quarantine + scanning scenarios drive `hort-cli admin ...`. It is a
# pure-HTTP client crate (no DSN / hort-app / sqlx deps — see crates/hort-cli),
# so this compiles only its own subgraph, not the whole workspace. Built on
# rust:1.94-slim-trixie (workspace MSRV) so the binary's glibc matches the trixie
# final stage — the same builder image the server/worker images pin. cargo needs
# every member's Cargo.toml for workspace resolution, hence `COPY crates`, but
# only hort-cli's subgraph is compiled.
FROM rust:1.94-slim-trixie AS cli-builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
# `.cargo/config.toml` declares the `hort-crates` registry that every
# intra-workspace dependency names. Cargo refuses to PARSE a manifest
# naming a registry it has no index declaration for, so without this the
# build fails before it compiles anything. `path` still resolves locally —
# declaring an index does not fetch it.
COPY .cargo ./.cargo
# hort-cli depends on hort-attribution, which embeds these workspace-root files
# at compile time via `include_str!` (the dual licenses and the generated
# third-party manifests). Without them the build fails with "couldn't read
# `.../LICENSE-MIT`: No such file or directory". Mirrors docker/Dockerfile.hort-server.
COPY LICENSE-MIT LICENSE-APACHE THIRD-PARTY-LICENSES.md THIRD-PARTY-LICENSES.json ./
COPY crates ./crates
# sharing=locked on the cargo-registry cache, uniform with the server/worker/
# compose Dockerfiles: this cache id is shared across builds, so serialize
# unpacks to keep it race-free under any concurrency.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target \
    cargo build --release -p hort-cli && \
    cp target/release/hort-cli /usr/local/bin/hort-cli

# ---------- Stage 2: the client image ----------
# Based on python:3.12-slim-trixie (ships pip 24.x) rather than debian:trixie-slim:
# scenarios create venvs (`python3 -m venv`) and the python:*-slim images seed them
# (via ensurepip) with a modern pip. An older stock Debian pip mishandled hort's
# PEP 658/714 simple-index metadata ("TypeError: unhashable type: 'dict'"). Trixie
# keeps Python 3.12, so this stays on 3.12 — matching run-e2e's proven PYPI_IMAGE.
FROM python:3.14-slim-trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash curl ca-certificates jq git xz-utils \
      gcc libc6-dev \
      postgresql-client \
      skopeo \
    && rm -rf /var/lib/apt/lists/*
# Node 20 via NodeSource (a pinned major independent of the base image; the smokes are validated on 20).
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
# Rust/cargo (matches the retired run-e2e CARGO_IMAGE 1.88).
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.88.0
ENV PATH="/root/.cargo/bin:${PATH}"
# Python publish/build tooling baked in so scenarios never pip-install at runtime.
# (The base image's pip is not externally-managed, so no --break-system-packages.)
RUN python3 -m pip install --no-cache-dir build twine
# JDK + Maven + Gradle for the maven/gradle scenario (clients/maven.sh:
# `mvn deploy`/`dependency:get` + `gradle publish`/resolve). trixie dropped
# openjdk-17, so this uses openjdk-21 (trixie's LTS JDK); JDK 21 still compiles
# and runs the scenario's maven.compiler.target=17 (backward compatible).
# Maven + Gradle are installed from PINNED, CHECKSUM-VERIFIED distributions
# (Debian's maven package is stale and pulls a large dep tree). The daemon is
# disabled at runtime via `gradle --no-daemon` in the scenario.
RUN apt-get update && apt-get install -y --no-install-recommends \
      openjdk-21-jdk-headless unzip \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ARG MAVEN_VERSION=3.9.9
ARG MAVEN_SHA512=a555254d6b53d267965a3404ecb14e53c3827c09c3b94b5678835887ab404556bfaf78dcfe03ba76fa2508649dca8531c74bca4d5846513522404d48e8c4ac8b
RUN curl -fsSL -o /tmp/maven.tar.gz \
      "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
    && echo "${MAVEN_SHA512}  /tmp/maven.tar.gz" | sha512sum -c - \
    && tar -xzf /tmp/maven.tar.gz -C /opt \
    && ln -s "/opt/apache-maven-${MAVEN_VERSION}/bin/mvn" /usr/local/bin/mvn \
    && rm -f /tmp/maven.tar.gz
ARG GRADLE_VERSION=8.10.2
ARG GRADLE_SHA256=31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26
RUN curl -fsSL -o /tmp/gradle.zip \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
    && echo "${GRADLE_SHA256}  /tmp/gradle.zip" | sha256sum -c - \
    && unzip -q /tmp/gradle.zip -d /opt \
    && ln -s "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle \
    && rm -f /tmp/gradle.zip
# cosign — the keyed-provenance signer for the push-then-sign round-trip
# (scenarios/quarantine/provenance-push-then-sign.sh). Pulled from a PINNED,
# CHECKSUM-VERIFIED GitHub release (same idiom as Maven/Gradle above), NOT the
# Debian repo (which has no cosign package). v3.x matches the operator's
# `cosign v3.0.4` (ADR 0039 §9 requires `--registry-referrers-mode=oci-1-1`,
# a v2+/v3 flag). skopeo does the push/pull; cosign does only sign + the test
# `generate-key-pair` — buildah is NOT needed.
ARG COSIGN_VERSION=3.0.4
ARG COSIGN_SHA256=10dab2fd2170b5aa0d5c0673a9a2793304960220b314f6a873bf39c2f08287aa
RUN curl -fsSL -o /usr/local/bin/cosign \
      "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64" \
    && echo "${COSIGN_SHA256}  /usr/local/bin/cosign" | sha256sum -c - \
    && chmod +x /usr/local/bin/cosign
# hort's own reference keyed-signing script (.gitlab/ci/cosign-sign.sh). The
# provenance push-then-sign scenario reads it from this path to pin the exact
# `cosign sign` flag set hort's CI signs with against the flags hort's own
# provenance gate accepts (issue #18). Build context is the REPO ROOT (run.sh),
# so the .gitlab/ path resolves.
COPY .gitlab/ci/cosign-sign.sh /usr/local/bin/hort-cosign-sign.sh
RUN chmod +x /usr/local/bin/hort-cosign-sign.sh
# The hort-cli admin client (built in stage 1) — used by the quarantine +
# scanning scenarios that drive admin/release/rescan flows over HTTP.
COPY --from=cli-builder /usr/local/bin/hort-cli /usr/local/bin/hort-cli
WORKDIR /work
